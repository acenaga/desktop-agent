# Copia este archivo como .env.local (ignorado por git) y ajusta los valores.
# Vite solo lee estas variables al arrancar: reinicia `npm run dev` tras cambiarlas.

# URL del servicio local de LocalDesk
VITE_API_BASE_URL=http://127.0.0.1:8000

# Debe coincidir con el token usado al iniciar el backend:
#   python -m local_agent.cli serve --host 127.0.0.1 --port 8000 --token <token> --print-token
VITE_API_TOKEN=cambia-este-token
