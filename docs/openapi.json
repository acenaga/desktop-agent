  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "action_id": {
            "type": "string",
            "title": "Action Id"
          },
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "arguments": {
            "additionalProperties": true,
            "type": "object",
            "title": "Arguments"
          },
          "canonical_arguments": {
            "additionalProperties": true,
            "type": "object",
            "title": "Canonical Arguments"
          },
          "brief_reason": {
            "type": "string",
            "title": "Brief Reason"
          },
          "expected_result": {
            "type": "string",
            "title": "Expected Result"
          },
          "state": {
            "$ref": "#/components/schemas/ActionState",
            "default": "proposed"
          },
          "scope_version": {
            "type": "integer",
            "title": "Scope Version",
            "default": 1
          },
          "observation_id": {
            "anyOf": [
              {
                "type": "string"
