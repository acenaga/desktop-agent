            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "executed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Executed At"
          }
        },
        "type": "object",
        "required": [
          "task_id",
          "tool",
          "brief_reason",
          "expected_result"
        ],
        "title": "Action"
      },
      "ActionState": {
        "type": "string",
        "enum": [
          "proposed",
          "pending_approval",
          "approved",
          "rejected",
          "executing",
          "completed",
          "failed",
          "cancelled"
        ],
        "title": "ActionState"
      },
      "ApprovalResolutionRequest": {
        "properties": {
          "approved": {
            "type": "boolean",
            "title": "Approved"
          }
        },
        "type": "object",
        "required": [
          "approved"
        ],
        "title": "ApprovalResolutionRequest"
      },
      "Artifact": {
        "properties": {
          "artifact_id": {
            "type": "string",
            "title": "Artifact Id"
          },
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "file_path": {
            "type": "string",
            "title": "File Path"
          },
          "file_name": {
            "type": "string",
            "title": "File Name"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
